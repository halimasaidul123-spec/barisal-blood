{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "cf:build": "vite build",
    "deploy:cf": "npm run build && wrangler pages deploy dist",
    "d1:create": "wrangler d1 create barishal-rokto-d1",
    "d1:migrate:local": "wrangler d1 execute barishal-rokto-d1 --local --file=./migrations/0001_d1_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute barishal-rokto-d1 --remote --file=./migrations/0001_d1_schema.sql",
    "d1:seed:remote": "wrangler d1 execute barishal-rokto-d1 --remote --file=./migrations/0002_d1_seed.sql",
    "cf:preview": "wrangler pages dev dist --d1=DB=barishal-rokto-d1",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.151.0"
  }
}
